{
  "name": "w1913",
  "version": "0.3.0",
  "description": "Look words up in the 1913 Webster's offline or from the command line (npx w1913 saunter), with the same answers as w1913.com.",
  "homepage": "https://w1913.com",
  "license": "MIT",
  "type": "module",
  "bin": {
    "w1913": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "HELP.txt",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cschweda/w1913.git",
    "directory": "packages/lookup"
  },
  "keywords": [
    "dictionary",
    "webster",
    "1913",
    "offline",
    "lookup",
    "cli",
    "public-domain"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  }
}
